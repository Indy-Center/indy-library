/**
 * Cloudflare Worker config for library.flyindycenter.com.
 *
 * Load-bearing for sign-in, as in training-tools:
 *   - `routes` keeps us on a *.flyindycenter.com subdomain, the only place the
 *     browser sends identity's `fic_session` cookie.
 *   - `services.IDENTITY` is the RPC binding to the identity Worker. It is not
 *     internet-reachable, needs no secret, and only resolves on this account.
 *
 * `services.TRAINING` is training-tools' `Teaching` entrypoint. Its one method,
 * `coursesTaught(cid)`, says which courses a reader may teach, which decides
 * whose teacher notes are shown. Without it nobody but the Training Admin and
 * lead instructors sees teacher notes.
 *
 * Secret, not a var (set it once, never commit it):
 *   wrangler secret put LIBRARY_API_TOKEN
 * The CMS's server credential for the courseware documents, sent as
 * `Authorization: Bearer <token>` to CMS_URL.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "indy-library",
	"account_id": "afd63515948c9b2188ce14ef1504b2c1",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-09-20",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"PUBLIC_IDENTITY_URL": "https://auth.flyindycenter.com",
		"CMS_URL": "https://cms.flyindycenter.com"
	},
	"routes": [{ "pattern": "library.flyindycenter.com", "custom_domain": true }],
	"services": [
		{ "binding": "IDENTITY", "service": "identity" },
		{ "binding": "TRAINING", "service": "training-tools", "entrypoint": "Teaching" }
	]
}
